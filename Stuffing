#ifndef STUFFING_H
#define STUFFING_H

#define FLAG_BITS    "01111110"
#define ESC_BITS     "01111101"
#define ADDR_BITS    "00000000"
#define CTRL_BITS    "11111111"
#define FCS_BITS     "00000000000000000000000000000000"

void byteStuffing(const char *input, char *output);
void byteDestuffing(const char *input, char *output);

#endif
#include <stdio.h>
#include <string.h>
#include "stuffing.h"
int i;
void byteStuffing(const char *input, char *output) {
    int len = strlen(input);
    int j = 0;

    for (i = 0; i < len; i += 8) {
        char currentByte[9];
        strncpy(currentByte, input + i, 8);
        currentByte[8] = '\0';

        if (strcmp(currentByte, FLAG_BITS) == 0 || strcmp(currentByte, ESC_BITS) == 0) {
            strcpy(output + j, ESC_BITS);
            j += 8;
        }
        strcpy(output + j, currentByte);
        j += 8;
    }
    output[j] = '\0';
}

void byteDestuffing(const char *input, char *output) {
    int len = strlen(input);
    int j = 0;

    for (i = 0; i < len; i += 8) {
        char currentByte[9];
        strncpy(currentByte, input + i, 8);
        currentByte[8] = '\0';

        if (strcmp(currentByte, ESC_BITS) == 0) {
            i += 8;
            strncpy(currentByte, input + i, 8);
            currentByte[8] = '\0';
        }
        strcpy(output + j, currentByte);
        j += 8;
    }
    output[j] = '\0';
}#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "stuffing.h"

void handleStuffing() {
    FILE *fin = fopen("byt.txt", "r");
    FILE *fout = fopen("byteout.txt", "w");

    if (!fin) {
        printf("Error: byt.txt not found!\n");
        if (fout) fclose(fout);
        return;
    }

    char rawData[4096] = {0};
    if (fscanf(fin, "%4095s", rawData) != 1) {
        printf("Error: byt.txt is empty.\n");
        fclose(fin);
        fclose(fout);
        return;
    }
    fclose(fin);

    int maxBytes;
    printf("Enter Frame Size(in BYTES): ");
    if (scanf("%d", &maxBytes) != 1 || maxBytes <= 0) {
        printf("Invalid frame restriction size.\n");
        fclose(fout);
        return;
    }

    int maxBits = maxBytes * 8;
    int totalLen = strlen(rawData);
    int currentPos = 0;
    int frameCount = 1;

    while (currentPos < totalLen) {
        char chunk[4096] = {0};
        char stuffedChunk[4096] = {0};

        strncpy(chunk, rawData + currentPos, maxBits);
        chunk[maxBits] = '\0';

        byteStuffing(chunk, stuffedChunk);
        printf("Frame %d full transmission bitstream:\n", frameCount++);
        printf("%s%s%s%s%s%s\n\n", FLAG_BITS, ADDR_BITS, CTRL_BITS, stuffedChunk, FCS_BITS, FLAG_BITS);

        fprintf(fout, "%s%s%s%s%s%s", FLAG_BITS, ADDR_BITS, CTRL_BITS, stuffedChunk, FCS_BITS, FLAG_BITS);
        //printf("Frame %d created with chunk length: %d bits\n", frameCount++, (int)strlen(chunk));

        currentPos += maxBits;
    }

    fclose(fout);
    printf("Successfully saved all byte-stuffed frames continuously to 'byteout.txt'\n");
}

void handleDestuffing() {
    FILE *fin = fopen("byteout.txt", "r");
    if (!fin) {
        printf("Error: byteout.txt not found!\n");
        return;
    }

    char dynamicStream[16384] = {0};
    if (fscanf(fin, "%16383s", dynamicStream) != 1) {
        printf("Error: byteout.txt is empty.\n");
        fclose(fin);
        return;
    }
    fclose(fin);

    int streamLen = strlen(dynamicStream);
    char finalOutput[16384] = {0};
    int frameCount = 1;
    int errorOccurred = 0;

    int flagLen = strlen(FLAG_BITS);
    int addrLen = strlen(ADDR_BITS);
    int ctrlLen = strlen(CTRL_BITS);
    int fcsLen = strlen(FCS_BITS);

    int i = 0;
    //printf("\n--- Processing Continuous Stream Using Byte Flag Identification ---\n");

    while (i < streamLen) {
        if (strncmp(dynamicStream + i, FLAG_BITS, flagLen) != 0) {
            printf("[ERROR]: Missing expected opening FLAG boundary marker.\n");
            errorOccurred = 1;
            break;
        }

        int payloadStart = i + flagLen + addrLen + ctrlLen;
        int currentPointer = payloadStart;
        int foundClosingFlag = 0;

        // Scan by exact 8-bit blocks (byte alignment) to avoid overlapping zero-bit pattern traps
        while (currentPointer <= streamLen - flagLen) {
            if (strncmp(dynamicStream + currentPointer, FLAG_BITS, flagLen) == 0) {
                // Verify that this is followed by the start of a new frame, or is the end of the stream
                int nextFramePos = currentPointer + flagLen;
                if (nextFramePos == streamLen || strncmp(dynamicStream + nextFramePos, FLAG_BITS, flagLen) == 0) {
                    foundClosingFlag = 1;
                    break;
                }
            }
            currentPointer += 8;
        }

        if (!foundClosingFlag) {
            printf("[ERROR]: Incomplete frame sequence. Missing closing FLAG marker.\n");
            errorOccurred = 1;
            break;
        }

        int payloadEnd = currentPointer - fcsLen;
        int payloadLen = payloadEnd - payloadStart;

        if (payloadLen < 0) {
            printf("[ERROR]: Frame %d structural data fields are corrupted.\n", frameCount);
            errorOccurred = 1;
            break;
        }

        char stuffedPayload[4096] = {0};
        strncpy(stuffedPayload, dynamicStream + payloadStart, payloadLen);
        stuffedPayload[payloadLen] = '\0';

        char destuffedChunk[4096] = {0};
        byteDestuffing(stuffedPayload, destuffedChunk);

        strcat(finalOutput, destuffedChunk);
        //printf("Frame %d identified and decoded successfully via flags.\n", frameCount++);

        i = currentPointer + flagLen;
    }

    if (!errorOccurred) {
        printf("Final Reassembled Original Data: %s\n", finalOutput);
    }
}

int main() {
    int choice;

    printf("1.Byte Stuffing\n");
    printf("2.Byte De-Stuffing\n");
    printf("Enter choice: ");

    if (scanf("%d", &choice) != 1) {
        printf("Invalid selection.\n");
        return 0;
    }

    if (choice == 1) {
        handleStuffing();
    } else if (choice == 2) {
        handleDestuffing();
    } else {
        printf("Invalid selection.\n");
    }

    return 0;
}
