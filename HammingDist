int totalHammingDistance(int* nums, int numsSize) {
    int totalDistance = 0;
    
    // Iterate through each of the 32 possible bit positions
    for (int i = 0; i < 30; i++) {
        int countOnes = 0;
        
        // Count how many numbers have the i-th bit set to 1
        for (int j = 0; j < numsSize; j++) {
            if ((nums[j] >> i) & 1) {
                countOnes++;
            }
        }
        
        // Number of zeros at the i-th bit position
        int countZeros = numsSize - countOnes;
        
        // Total differing pairs at this bit position
        totalDistance += countOnes * countZeros;
    }
    
    return totalDistance;
}
