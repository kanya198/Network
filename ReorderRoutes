typedef struct Edge {
    int to;
    int dir; // 1 if original direction (away from 0, needs reorder), 0 if artificial/reversed
    struct Edge* next;
} Edge;

// Function to add an edge to the graph
void addEdge(Edge** adj, int from, int to, int dir) {
    Edge* newEdge = (Edge*)malloc(sizeof(Edge));
    newEdge->to = to;
    newEdge->dir = dir;
    newEdge->next = adj[from];
    adj[from] = newEdge;
}

int minReorder(int n, int** connections, int connectionsSize, int* connectionsColSize) {
    // Allocate memory for adjacency list
    Edge** adj = (Edge**)calloc(n, sizeof(Edge*));
    
    // Build the bidirectional graph
    for (int i = 0; i < connectionsSize; i++) {
        int u = connections[i][0];
        int v = connections[i][1];
        // Original edge u -> v: moving this way means moving away from 0, so dir = 1
        addEdge(adj, u, v, 1);
        // Artificial reverse edge v -> u: moving this way means moving toward 0, so dir = 0
        addEdge(adj, v, u, 0);
    }
    
    // BFS Queue initialization
    int* queue = (int*)malloc(n * sizeof(int));
    bool* visited = (bool*)calloc(n, sizeof(bool));
    int head = 0, tail = 0;
    
    // Start BFS from city 0
    queue[tail++] = 0;
    visited[0] = true;
    
    int reorderCount = 0;
    
    while (head < tail) {
        int curr = queue[head++];
        
        Edge* edge = adj[curr];
        while (edge != NULL) {
            int neighbor = edge->to;
            if (!visited[neighbor]) {
                visited[neighbor] = true;
                // If the edge points away from city 0, we must reverse it
                reorderCount += edge->dir;
                queue[tail++] = neighbor;
            }
            edge = edge->next;
        }
    }
    
    // Free allocated memory
    for (int i = 0; i < n; i++) {
        Edge* edge = adj[i];
        while (edge != NULL) {
            Edge* tmp = edge;
            edge = edge->next;
            free(tmp);
        }
    }
    free(adj);
    free(queue);
    free(visited);
    
    return reorderCount;
}
