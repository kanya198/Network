void bitStuffing(const char *input, char *output) {
    int count = 0;
    int j = 0;
    int i;
    int startedAfterZero = 0; // Tracks if we have seen the initial '0'

    for (i = 0; input[i] != '\0'; i++) {
        output[j++] = input[i]; // Copy current bit

        if (input[i] == '0') {
            count = 0;          // Reset count because a new sequence starts after this '0'
            startedAfterZero = 1; // Mark that we found our starting '0'
        }
        else if (input[i] == '1' && startedAfterZero) {
            count++;            // Count '1's that come after the '0'

            if (count == 5) {
                output[j++] = '0'; // Stuff '0' immediately after the 5th '1'
                count = 0;         // Reset count
                startedAfterZero = 0; // Clear flag until next '0'
            }
        }
    }
    output[j] = '\0';
}

// Bit Destuffing: First checks for error, then destuffs.

#include <stdio.h>

int bitDestuffing(const char *input, char *output) {
    int count = 0;
    int i = 0, j = 0;
    int after_zero = 0; // Flag to track if we are in a sequence following a '0'

    // 1. Strict Error Check & Counting Pass
    for (i = 0; input[i] != '\0'; i++) {
        if (input[i] == '0') {
            after_zero = 1; // Next 1s will be counted
            count = 0;
        } else if (input[i] == '1') {
            if (after_zero) {
                count++;
                if (count >= 7) {
                    return -1; // Error: 7 consecutive 1s after a 0
                }
            }
        } else {
            return -1; // Invalid character check
        }
    }

    // 2. Destuffing Pass
    count = 0;
    after_zero = 0;
    for (i = 0; input[i] != '\0'; i++) {
        output[j++] = input[i];

        if (input[i] == '0') {
            after_zero = 1;
            count = 0;
        } else if (input[i] == '1') {
            if (after_zero) {
                count++;
            }
        }

        // If 5 valid 1s are found after a 0, check for stuffed bit
        if (count == 5 && after_zero) {
            if (input[i + 1] == '0') {
                i++; // Skip the stuffed '0' bit
            }
            count = 0; // Reset counter after handling the stuffed bit
        }
    }
    output[j] = '\0';
    return 0; // Success
}
