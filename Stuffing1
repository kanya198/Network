void handleStuffing() {
    FILE *fin = fopen("inpt.txt", "r");
    FILE *fout = fopen("stuff.txt", "w");

    if (!fin) {
        printf("Error: input.txt not found! Create 'input.txt' first.\n");
        if (fout) fclose(fout);
        return;
    }

    char rawData[4096] = {0};
    if (fscanf(fin, "%4095s", rawData) != 1) {
        printf("Error: input.txt is empty or invalid.\n");
        fclose(fin);
        fclose(fout);
        return;
    }
    fclose(fin);

    int maxBits;
    printf("Enter maximum data bits allowed per frame: ");
    if (scanf("%d", &maxBits) != 1 || maxBits <= 0) {
        printf("Invalid frame restriction size.\n");
        fclose(fout);
        return;
    }

    int totalLen = strlen(rawData);
    int currentPos = 0;
    int frameCount = 1;

    printf("\n--- Framing Summary ---\n");

    while (currentPos < totalLen) {
        char chunk[4096] = {0};
        char stuffedChunk[4096] = {0};
        strncpy(chunk, rawData + currentPos, maxBits);
        chunk[maxBits] = '\0';

        bitStuffing(chunk, stuffedChunk);
        fprintf(fout, "%s%s%s%s%s%s", FLAG, ADDRESS, CONTROL, stuffedChunk, FCS, FLAG);
       // printf("Frame %d created with chunk: %s\n", frameCount++, chunk);
        printf("Frame %d: %s%s%s%s%s%s\n", frameCount++, FLAG, ADDRESS, CONTROL, stuffedChunk, FCS, FLAG);
        currentPos += maxBits;
    }

    fclose(fout);
}

void handleDestuffing() {
    FILE *fin = fopen("stuff.txt", "r");
    if (!fin) {
        printf("Error: stuff.txt not found!\n");
        return;
    }

    char dynamicStream[8192] = {0};
    if (fscanf(fin, "%8191s", dynamicStream) != 1) {
        printf("Error: 'stuff.txt' is empty.\n");
        fclose(fin);
        return;
    }
    fclose(fin);

    int streamLen = strlen(dynamicStream);
    char finalOutput[8192] = {0};
    int frameCount = 1;
    int errorOccurred = 0;

    int flagLen = strlen(FLAG);
    int addrLen = strlen(ADDRESS);
    int ctrlLen = strlen(CONTROL);
    int fcsLen = strlen(FCS);

    int i = 0;

    while (i < streamLen) {
        if (strncmp(dynamicStream + i, FLAG, flagLen) != 0) {
            printf("[ERROR]: Missing expected opening FLAG boundary marker.\n");
            errorOccurred = 1;
            break;
        }

        int payloadStart = i + flagLen + addrLen + ctrlLen;
        int currentPointer = payloadStart;
        int foundClosingFlag = 0;
        while (currentPointer <= streamLen - flagLen) {
            if (strncmp(dynamicStream + currentPointer, FLAG, flagLen) == 0) {
                foundClosingFlag = 1;
                break;
            }
            currentPointer++;
        }

        if (!foundClosingFlag) {
            printf("[ERROR]: Incomplete frame sequence. Missing closing FLAG marker.\n");
            errorOccurred = 1;
            break;
        }

        int payloadEnd = currentPointer - fcsLen;
        int payloadLen = payloadEnd - payloadStart;

        if (payloadLen < 0) {
            printf("[ERROR]: Frame %d structural data fields are corrupted.\n", frameCount);
            errorOccurred = 1;
            break;
        }

        char stuffedPayload[4096] = {0};
        strncpy(stuffedPayload, dynamicStream + payloadStart, payloadLen);
        stuffedPayload[payloadLen] = '\0';

        char destuffedChunk[4096] = {0};
        int status = bitDestuffing(stuffedPayload, destuffedChunk);

        if (status == -1) {
            printf("\nERROR in received Frame %d!Process stopped.\n", frameCount);
            errorOccurred = 1;
            break;
        }

        strcat(finalOutput, destuffedChunk);
        printf("Frame %d destuffed successfully!.\n", frameCount++);

        i = currentPointer + flagLen;
    }

    if (!errorOccurred) {
        printf("Original Data: %s\n", finalOutput);
    }
}

